{
  "name": "strateg-russia-final",
  "version": "1.0.0",
  "description": "STRATEG-RUSSIA: Объединенный мессенджер с красивым UI и надежным ядром",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/coordinator.ts",
    "http": "tsx http-server.ts",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build:all": "npm run build && echo 'Frontend built successfully'",
    "install:all": "npm install",
    "clean": "rm -rf dist node_modules/.vite",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "framer-motion": "^12.23.24",
    "html5-qrcode": "^2.3.8",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.27",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^4.4.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "strateg",
    "russia",
    "messenger",
    "websocket",
    "react"
  ],
  "author": "STRATEG Team",
  "license": "MIT"
}
